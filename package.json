{
  "name": "fretbloom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run wasm:verify && vite",
    "build": "npm run wasm:verify && tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test validation/live/fixtures.test.mjs validation/wasm/control-entry.mjs && vitest run",
    "format": "prettier --write",
    "check:fast": "npm run lint && npm run typecheck && npm test",
    "check:staged": "node scripts/check-staged.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "preview": "vite preview",
    "setup:separator": "node scripts/setup-separator.mjs",
    "setup:youtube": "node scripts/setup-youtube.mjs",
    "start": "node server/index.ts",
    "test:youtube": "node e2e-youtube-sync.mjs",
    "test:lyrics": "node e2e-lyrics.mjs",
    "dev:full": "npm run wasm:verify && node scripts/start-local.mjs",
    "start:full": "node scripts/start-production.mjs",
    "test:rust-analysis": "node e2e-rust-analysis.mjs",
    "wasm:bootstrap": "node scripts/wasm-bootstrap.mjs",
    "wasm:build": "node scripts/wasm-build.mjs",
    "wasm:verify": "node scripts/wasm-verify.mjs"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.57.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^24.22.2"
  }
}
