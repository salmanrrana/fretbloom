{
  "name": "fretbloom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "format": "prettier --write",
    "check:fast": "npm run lint && npm run typecheck && npm test",
    "check:staged": "node scripts/check-staged.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "preview": "vite preview",
    "setup:youtube": "node scripts/setup-youtube.mjs",
    "start": "node server/index.ts",
    "test:youtube": "node e2e-youtube-sync.mjs",
    "test:lyrics": "node e2e-lyrics.mjs"
  },
  "dependencies": {
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.57.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
